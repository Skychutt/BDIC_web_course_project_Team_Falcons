# Mock mode works without MySQL or an API key.
# If local_mysql.py already created .env, edit that file; do not overwrite it.
DATA_SOURCE=mock
AI_PROVIDER=stub
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=10
# backend mode requires both fields below. Use your actual local configuration.
DATABASE_URL=
SECRET_KEY=
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5001
# Optional AMap Web JS API credentials (values must be on the same line as =).
# JS Key is public in the browser; securityJsCode stays behind the Flask proxy.
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
