# If local_mysql.py already created .env, edit that file; do not overwrite it.
#
# Quick AI demo without MySQL:
#   DATA_SOURCE=mock
# Full booking website (matches teammates' falcons. UI):
#   DATA_SOURCE=backend
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/cinema_demo
#   SECRET_KEY=at-least-32-random-characters
# Optional Windows DB tests (account must create/drop schemas):
#   TEST_DATABASE_URL=mysql+pymysql://test_user:PASSWORD@127.0.0.1:3306/mysql
DATA_SOURCE=mock
AI_PROVIDER=stub
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Whole-turn budget, including model follow-ups after business queries (max 60).
AI_TIMEOUT_SECONDS=30
# Signed-in account message limits. The IP threshold only logs a burst.
AI_MESSAGES_PER_MINUTE=6
AI_MESSAGES_PER_DAY=50
AI_IP_ALERT_PER_MINUTE=60
# backend mode requires both fields below. Use your actual local configuration.
DATABASE_URL=
SECRET_KEY=
COOKIE_SECURE=false
HOST=127.0.0.1
PORT=5001
# Optional AMap Web JS API credentials (values must be on the same line as =).
# JS Key is public in the browser; securityJsCode stays behind the Flask proxy.
AMAP_JS_KEY=
AMAP_SECURITY_CODE=

# Outgoing mail for customer registration and counter sale verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
